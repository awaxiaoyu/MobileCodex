{
  "name": "mobile-codex-bridge",
  "version": "0.2.0",
  "description": "A Windows Bridge and Android client for continuing Codex Desktop tasks from a paired phone.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/awaxiaoyu/MobileCodex.git"
  },
  "bugs": {
    "url": "https://github.com/awaxiaoyu/MobileCodex/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.ts serve",
    "discover": "node src/cli.ts discover",
    "probe:desktop": "node scripts/probe-desktop.ts",
    "smoke:standalone": "node scripts/smoke-standalone.ts",
    "smoke:desktop": "node scripts/smoke-desktop.ts",
    "inject:renderer": "node scripts/inject-renderer.ts",
    "smoke:frida": "node scripts/smoke-frida.ts",
    "smoke:turn": "node scripts/smoke-turn.ts",
    "smoke:plan": "node scripts/smoke-plan.ts",
    "smoke:mobile": "node scripts/smoke-mobile-desktop.ts",
    "benchmark": "node scripts/benchmark.ts",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "7.0.2"
  }
}
